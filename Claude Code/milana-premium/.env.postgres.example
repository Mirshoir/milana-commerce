DATABASE_URL=postgres://milana:milana_dev_password@127.0.0.1:5432/milana

# Product catalog is managed manually from the admin panel by default.
# Set either value to 1 only for temporary imports/tests.
CATALOG_SOURCE_ENABLED=0
SEED_FALLBACK_CATALOG=0
# Optional external catalog API. When enabled, products are read from this API
# and /storage/* image paths are proxied through this website backend.
CATALOG_API_BASE=http://172.16.10.4:8003
CATALOG_API_TOKEN=

# Telegram order notifications. Create the bot with BotFather, add it to the
# manager chat/group, then set the destination chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=
# Optional: topic/thread id for Telegram forum groups.
# TELEGRAM_ORDER_THREAD_ID=
# Set to 0 to keep the token configured but pause notifications.
TELEGRAM_ORDERS_ENABLED=1

# Optional SMS delivery for phone OTP.
# The backend posts JSON to this URL: { phone, message, purpose, lang }.
# Keep empty in local development; local OTP responses include dev_code.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Set to 1 only when you want local/staging to send real SMS through the webhook.
SMS_SEND_IN_DEV=0

# Email delivery for password recovery verification.
# Recommended: direct Resend API. Replace re_xxxxxxxxx with your real API key.
RESEND_API_KEY=re_xxxxxxxxx
# For production, verify milanapremium.uz in Resend and use a domain sender.
RESEND_FROM_EMAIL=Milana Premium <onboarding@resend.dev>

# Optional fallback email webhook.
# The backend posts JSON to this URL: { to, subject, text, purpose, lang }.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
# Set to 1 only when you want local/staging to send real email through Resend/webhook.
EMAIL_SEND_IN_DEV=0

# OpenAI smart assistant. Replace with a real project key only in ignored env files or server env.
OPENAI_API_KEY=sk-proj_xxxxxxxxx
OPENAI_MODEL=gpt-5.5
OPENAI_ASSISTANT_ENABLED=1

# During the transition, the server can still read the existing SQLite file.
# The migration tool uses SQLITE_DB when it is set; otherwise it reads data/milana.db.
# SQLITE_DB=/absolute/path/to/milana.db
