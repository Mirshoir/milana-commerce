rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isText(value, max) {
      return value is string && value.size() <= max;
    }

    function ownsCustomerDoc(customerId) {
      return request.auth != null && request.auth.uid == customerId;
    }

    function validCustomerProfile(customerId) {
      return ownsCustomerDoc(customerId) &&
        request.resource.data.keys().hasAll([
          'email', 'name', 'phone', 'city', 'address', 'status',
          'created_at', 'updated_at'
        ]) &&
        request.resource.data.keys().hasOnly([
          'email', 'name', 'phone', 'city', 'address', 'status',
          'company_name', 'country',
          'saved_product_ids', 'recent_product_ids', 'cart_items',
          'legal_consent_version', 'legal_accepted_at',
          'created_at', 'updated_at'
        ]) &&
        isText(request.resource.data.email, 120) &&
        request.auth.token.email is string &&
        request.resource.data.email == request.auth.token.email &&
        isText(request.resource.data.name, 80) &&
        request.resource.data.name.size() >= 2 &&
        isText(request.resource.data.phone, 25) &&
        (request.resource.data.phone.size() == 0 ||
          request.resource.data.phone.size() >= 5) &&
        request.resource.data.status == 'active' &&
        isText(request.resource.data.created_at, 40) &&
        isText(request.resource.data.updated_at, 40) &&
        validLegalConsent() &&
        validCustomerDeliveryProfile() &&
        validCustomerBusinessProfile() &&
        validSavedProducts() &&
        validRecentProducts() &&
        validProfileCart();
    }

    function validLegalConsent() {
      return (!request.resource.data.keys().hasAny(['legal_consent_version']) ||
          isText(request.resource.data.legal_consent_version, 40)) &&
        (!request.resource.data.keys().hasAny(['legal_accepted_at']) ||
          isText(request.resource.data.legal_accepted_at, 40));
    }

    function immutableCustomerAuditFields() {
      return request.resource.data.email == resource.data.email &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.created_at == resource.data.created_at &&
        request.resource.data.get('legal_consent_version', null) ==
          resource.data.get('legal_consent_version', null) &&
        request.resource.data.get('legal_accepted_at', null) ==
          resource.data.get('legal_accepted_at', null);
    }

    function validCustomerDeliveryProfile() {
      return (!request.resource.data.keys().hasAny(['city']) ||
          isText(request.resource.data.city, 80)) &&
        (!request.resource.data.keys().hasAny(['address']) ||
          isText(request.resource.data.address, 200));
    }

    function validCustomerBusinessProfile() {
      return (!request.resource.data.keys().hasAny(['company_name']) ||
          isText(request.resource.data.company_name, 160)) &&
        (!request.resource.data.keys().hasAny(['country']) ||
          isText(request.resource.data.country, 80));
    }

    function validSavedProducts() {
      return !request.resource.data.keys().hasAny(['saved_product_ids']) ||
        (request.resource.data.saved_product_ids is list &&
          request.resource.data.saved_product_ids.size() <= 500);
    }

    function validRecentProducts() {
      return !request.resource.data.keys().hasAny(['recent_product_ids']) ||
        (request.resource.data.recent_product_ids is list &&
          request.resource.data.recent_product_ids.size() <= 100);
    }

    function validProfileCart() {
      return !request.resource.data.keys().hasAny(['cart_items']) ||
        (request.resource.data.cart_items is list &&
          request.resource.data.cart_items.size() <= 100);
    }

    function validCustomerState(customerId, stateId) {
      return ownsCustomerDoc(customerId) &&
        request.resource.data.keys().hasAll(['schema_version', 'updated_at']) &&
        request.resource.data.keys().hasOnly([
          'schema_version', 'product_ids', 'items', 'updated_at'
        ]) &&
        request.resource.data.schema_version == 1 &&
        isText(request.resource.data.updated_at, 40) &&
        ((stateId == 'saved' &&
            request.resource.data.keys().hasAll(['product_ids']) &&
            request.resource.data.product_ids is list &&
            request.resource.data.product_ids.size() <= 500) ||
          (stateId == 'recent' &&
            request.resource.data.keys().hasAll(['product_ids']) &&
            request.resource.data.product_ids is list &&
            request.resource.data.product_ids.size() <= 100) ||
          (stateId == 'cart' &&
            request.resource.data.keys().hasAll(['items']) &&
            request.resource.data.items is list &&
            request.resource.data.items.size() <= 100));
    }

    function ownsResource() {
      return request.auth != null &&
        resource.data.keys().hasAny(['customer_id']) &&
        resource.data.customer_id == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    match /customers/{customerId} {
      allow read: if ownsCustomerDoc(customerId);
      allow create: if validCustomerProfile(customerId);
      allow update: if validCustomerProfile(customerId) &&
        immutableCustomerAuditFields();
      allow delete: if false;

      match /state/{stateId} {
        allow read: if ownsCustomerDoc(customerId);
        allow create, update: if validCustomerState(customerId, stateId);
        allow delete: if false;
      }
    }

    match /orders/{orderId} {
      allow read: if ownsResource();
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read, create, update, delete: if false;
    }

    match /support_requests/{ticketId} {
      allow read: if ownsResource();
      allow create, update, delete: if false;
    }

    match /distributor_applications/{applicationId} {
      allow read: if ownsResource();
      allow create, update, delete: if false;
    }

    match /customer_notifications/{notificationId} {
      allow read: if ownsResource();
      allow create, update, delete: if false;
    }

    match /notification_preferences/{customerId} {
      allow read: if ownsCustomerDoc(customerId);
      allow create, update, delete: if false;
    }

    match /notification_devices/{deviceId} {
      allow read, create, update, delete: if false;
    }

    match /erp_events/{eventId} {
      allow read, create, update, delete: if false;
    }

    // Written only by the trusted account-deletion callable. Feedback is
    // intentionally anonymous and is not exposed to customer clients.
    match /account_deletion_feedback/{feedbackId} {
      allow read, create, update, delete: if false;
    }

    match /payment_webhook_events/{eventId} {
      allow read, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
