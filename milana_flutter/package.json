{
  "name": "milana-flutter-firebase-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "export:catalog": "node tool/export_catalog_from_api.mjs",
    "mirror:images": "node tool/mirror_catalog_images.mjs",
    "sync:uploads": "node tool/sync_hosting_uploads.mjs",
    "import:catalog": "node tool/mirror_catalog_images.mjs && node tool/import_firestore_catalog.mjs --catalog firebase/catalog.firebase-products.json",
    "import:catalog:emulator": "node tool/mirror_catalog_images.mjs && node tool/import_firestore_catalog.mjs --catalog firebase/catalog.firebase-products.json --project milana-local --emulator-host 127.0.0.1:8080",
    "import:catalog:dry": "node tool/mirror_catalog_images.mjs --no-download && node tool/import_firestore_catalog.mjs --catalog firebase/catalog.firebase-products.json --dry-run",
    "verify:catalog:emulator": "node tool/verify_firestore_emulator.mjs products",
    "verify:indexes": "node tool/verify_firestore_indexes.mjs",
    "functions:test": "npm --prefix functions test",
    "functions:audit": "npm --prefix functions audit --omit=dev --audit-level=high",
    "test:emulator:catalog": "firebase emulators:exec --project milana-local --only firestore \"npm run import:catalog:emulator && npm run verify:catalog:emulator\"",
    "verify:customer-rules:emulator": "node tool/verify_customer_rules_emulator.mjs",
    "test:emulator:rules": "firebase emulators:exec --project milana-local --only auth,firestore \"npm run verify:customer-rules:emulator\"",
    "verify:customer-functions:emulator": "node tool/verify_checkout_function_emulator.mjs",
    "verify:checkout-function:emulator": "node tool/verify_checkout_function_emulator.mjs",
    "test:emulator:checkout": "PAYMENT_WEBHOOK_SECRET=local-payment-webhook-secret FUNCTIONS_DISCOVERY_TIMEOUT=60 firebase emulators:exec --project milana-local --only auth,firestore,functions \"npm run verify:checkout-function:emulator\"",
    "verify:hosting:emulator": "node tool/verify_hosting_emulator.mjs",
    "verify:hosting-tools:self-test": "node --test tool/test/hosting_asset_tools.test.mjs",
    "verify:load-test:self-test": "node --test tool/test/load_test_public_api.test.mjs",
    "verify:capacity:staging": "node tool/load_test_public_api.mjs",
    "test:emulator:full": "npm run build:emulator:web && PAYMENT_WEBHOOK_SECRET=local-payment-webhook-secret FUNCTIONS_DISCOVERY_TIMEOUT=60 firebase emulators:exec --project milana-local --only auth,firestore,functions,hosting \"npm run import:catalog:emulator && npm run verify:catalog:emulator && npm run verify:customer-rules:emulator && npm run verify:checkout-function:emulator && npm run verify:hosting:emulator\"",
    "prepare:firebase": "node tool/prepare_firebase_web.mjs",
    "prepare:firebase:mobile": "node tool/prepare_firebase_mobile.mjs",
    "verify:firebase": "node tool/verify_firebase_project.mjs",
    "verify:firebase:self-test": "node --test tool/test/verify_firebase_project.test.mjs && node tool/verify_firebase_project.mjs --self-test",
    "verify:pwa": "node tool/verify_pwa_manifest.mjs",
    "verify:workflow": "node tool/verify_github_workflow.mjs",
    "verify:store:prepared": "node tool/verify_store_listing.mjs --mode=prepared",
    "verify:store:submission": "node tool/verify_store_listing.mjs --mode=submission",
    "verify:store:submission:android": "node tool/verify_store_listing.mjs --mode=submission --platform=android",
    "verify:store:submission:ios": "node tool/verify_store_listing.mjs --mode=submission --platform=ios",
    "verify:store:self-test": "node --test tool/test/verify_store_listing.test.mjs",
    "verify:play-publisher:self-test": "node --test tool/test/publish_google_play_internal.test.mjs",
    "verify:app-store-publisher:self-test": "node --test tool/test/publish_app_store_connect.test.mjs",
    "verify:mobile-builder:self-test": "node --test tool/test/build_firebase_mobile.test.mjs",
    "publish:play:internal": "node tool/publish_google_play_internal.mjs",
    "publish:app-store-connect": "node tool/publish_app_store_connect.mjs",
    "verify:release:mobile": "node tool/verify_production_release.mjs --platform all --artifact appbundle --mode release",
    "verify:release:android": "node tool/verify_production_release.mjs --platform android --artifact appbundle --mode release",
    "verify:release:ios": "node tool/verify_production_release.mjs --platform ios --mode release",
    "verify:release:self-test": "node --test tool/test/verify_production_release.test.mjs",
    "verify:release:live": "node tool/verify_live_release_endpoints.mjs",
    "verify:release:live:self-test": "node --test tool/test/verify_live_release_endpoints.test.mjs",
    "admin:claims": "node tool/set_firebase_user_claims.mjs",
    "erp:bridge": "node tool/run_erp_bridge_worker.mjs",
    "deploy:firebase:functions": "firebase deploy --project \"$FIREBASE_PROJECT_ID\" --only functions",
    "build:firebase:android": "npm run verify:release:android && node tool/build_firebase_mobile.mjs --platform android --artifact appbundle --mode release",
    "build:firebase:android:debug": "node tool/build_firebase_mobile.mjs --platform android --artifact apk --mode debug",
    "build:firebase:ios:nocodesign": "node tool/build_firebase_mobile.mjs --platform ios --no-codesign",
    "build:firebase:web": "node tool/build_firebase_web.mjs",
    "deploy:firebase:web": "node tool/build_firebase_web.mjs --deploy",
    "build:emulator:web": "node tool/build_firebase_web.mjs --defines firebase/emulator-dart-defines.env",
    "emulators": "FUNCTIONS_DISCOVERY_TIMEOUT=60 firebase emulators:start --project milana-local --only auth,firestore,functions,hosting",
    "serve:web": "node tool/serve_build_web.mjs"
  }
}
